# Required: host directory containing the GGUF files.
# The compose mounts this read-only at /models inside the container.
MODELS_DIR=/h1005/jpoehler/models

# Required: random secret used as Bearer token by OpenWebUI/clients.
# Generate one with `openssl rand -hex 32`.
API_KEY=change-me-please

# CUDA arch for the build. 90=H100, 89=L40/4090, 86=A6000/3090, 80=A100.
# Set to "default" to build for all supported archs (slow build, fat image).
CUDA_DOCKER_ARCH=90

# Which GPU index inside the container to use. The container only sees
# this one device (you don't need CUDA_VISIBLE_DEVICES inside).
# Use "all" to expose every visible GPU.
CUDA_DEVICE_ID=0

# Port exposed on the host. OpenWebUI talks to http://host:HOST_PORT/v1.
HOST_PORT=8090

# GGUF filenames inside MODELS_DIR.
BASE_GGUF=gemma-4-31B-it.gguf
DRAFT_GGUF=gemma-4-31B-it-assistant.gguf

# llama-server runtime sizing.
# CONTEXT_SIZE is the total context across all slots. With PARALLEL_SLOTS=1
# the whole budget goes to one session; with PARALLEL_SLOTS=4 each session
# gets CONTEXT_SIZE/4.
CONTEXT_SIZE=8192
PARALLEL_SLOTS=1
